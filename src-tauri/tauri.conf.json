{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mieterm",
  "version": "1.0.0",
  "identifier": "com.mdenizay.mieterm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Mieterm",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, native SSH client and terminal",
    "longDescription": "An open-source alternative to Termius: saved servers, tabbed SSH and local terminals, split panes, command broadcast, port forwarding, SFTP and session recording. Credentials stay in the OS keychain.",
    "copyright": "MIT licensed. https://github.com/mdenizay/mieterm",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/mdenizay/mieterm/releases/latest/download/latest.json"],
      "dialog": false,
      "windows": { "installMode": "passive" },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOEVDNTJEQjQ0RUQxNjAKUldSZzBVNjBMY1dPd01pNktJb3J6TW9wdXB3YnhhVG1EaWk4elI5NjdYS3VvMHFQY1AxNFFldWIK"
    }
  }
}
